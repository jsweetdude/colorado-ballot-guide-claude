---
import Base from '../../layouts/Base.astro';
import { measures, localMeasures } from '../../lib/data';
import { LINKS } from '../../lib/site';
---
<Base title="Ballot measures" nav="measures" description="All 14 statewide measures on Colorado's 2026 ballot, in the official Blue Book's words.">
  <section class="page-head" aria-labelledby="h1">
    <h1 id="h1">Ballot measures</h1>
    <p class="lede">Every Colorado voter sees these 14 statewide measures. Descriptions, arguments for and against, and fiscal notes are quoted from the official <a href={LINKS.bluebook}>2026 Blue Book</a>, written by the legislature's nonpartisan staff.</p>
    <p class="small muted">Constitutional amendments usually need 55 percent of the vote; each measure below shows the threshold the Blue Book states for it.</p>
  </section>
  {measures.length === 0 && <p>Measure details are being added.</p>}
  <div class="pc-card pc-table-wrap">
    <table class="pc-table">
      <caption class="visually-hidden">Statewide measures</caption>
      <thead><tr><th scope="col">Measure</th><th scope="col">Changes</th><th scope="col">Needs</th></tr></thead>
      <tbody>
        {measures.map((m) => (
          <tr>
            <th scope="row"><a href={`/measures/${m.id}/`}>{m.label}</a>: {m.title}</th>
            <td>{m.changes === 'statute' ? 'State law' : m.changes === 'constitution' ? 'Constitution' : 'Constitution and law'}</td>
            <td>{m.threshold === '55 percent' ? '55%' : 'Majority'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {localMeasures.length > 0 && (
    <section class="stack-sm" aria-labelledby="local-h">
      <h2 id="local-h">Local measure</h2>
      <ul>{localMeasures.map((m) => <li><a href={`/measures/${m.id}/`}>{m.label}: {m.title}</a></li>)}</ul>
    </section>
  )}
</Base>
